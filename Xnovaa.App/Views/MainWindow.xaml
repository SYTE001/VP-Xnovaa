<Window x:Class="Xnovaa.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:svc="clr-namespace:Xnovaa.App.Services"
        Title="Xnovaa"
        Width="1280" Height="800" MinWidth="960" MinHeight="600"
        Background="{StaticResource BgMainBrush}"
        FontFamily="{StaticResource AppFont}"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStartupLocation="Manual"
        TextOptions.TextRenderingMode="ClearType">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" GlassFrameThickness="0" CornerRadius="0" ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="O" Command="{Binding ImportFilesCommand}"/>
    </Window.InputBindings>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- ================================================= ROW 0 : Header -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                    <TextBlock Text="◈" FontSize="16" Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Xnovaa" FontSize="14" FontWeight="SemiBold"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource IconButton}" Click="OnMinimizeClick" Content="—"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="MaximizeBtn" Style="{StaticResource IconButton}" Click="OnMaximizeClick"
                            Content="☐" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource IconButton}" Click="OnCloseClick" Content="✕"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================================= ROW 1 : Content (3 columns) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" x:Name="SidebarColumn"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320" x:Name="PlaylistColumn"/>
            </Grid.ColumnDefinitions>

            <!-- ================= Sidebar (kiri) -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox Style="{StaticResource SearchBox}" Margin="12,12,12,4"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                             x:Name="SearchInput"/>

                    <StackPanel Grid.Row="1" Margin="0,4,0,0">
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Content="⌂  Home" IsChecked="True"
                                     Command="{Binding NavigateCommand}" CommandParameter="Home"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Content="▦  Library"
                                     Command="{Binding NavigateCommand}" CommandParameter="Library"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Content="☰  Playlist"
                                     Command="{Binding NavigateCommand}" CommandParameter="Playlist"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Content="◷  Recently Added"
                                     Command="{Binding NavigateCommand}" CommandParameter="RecentlyAdded"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Content="★  Favorites"
                                     Command="{Binding NavigateCommand}" CommandParameter="Favorites"/>

                        <Separator Margin="12,10,12,6" Background="{StaticResource BorderBrush}"
                                   Height="1"/>
                        <TextBlock Text="Lokal" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" Margin="20,0,0,4"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Content="+  Import Files"
                                     Command="{Binding NavigateCommand}" CommandParameter="ImportFiles"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Content="⛃  Folders"
                                     Command="{Binding NavigateCommand}" CommandParameter="Folders"/>
                    </StackPanel>

                    <!-- Storage info -->
                    <StackPanel Grid.Row="3" Margin="16,8,16,12">
                        <ProgressBar x:Name="StorageBar" Height="6" Value="{Binding StorageUsedPercent, Mode=OneWay}"
                                     Maximum="100" Background="{StaticResource PanelLightBrush}"
                                     Foreground="{StaticResource AccentBrush}" BorderThickness="0"/>
                        <TextBlock Text="{Binding StorageText}" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= Player (tengah) -->
            <Grid Grid.Column="1" Margin="0" Background="{StaticResource BgMainBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Video area -->
                <Border x:Name="VideoBorder" Background="Black" Margin="12"
                        CornerRadius="8" ClipToBounds="True">
                    <Grid>
                        <lvc:VideoView x:Name="VideoViewHost">
                            <!-- overlay title -->
                            <Grid Background="Transparent" IsHitTestVisible="False">
                                <TextBlock x:Name="TitleOverlay" Text="{Binding CurrentTitle}"
                                           Foreground="#B0FFFFFF" FontSize="12"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"
                                           Margin="12,10"/>
                            </Grid>
                        </lvc:VideoView>
                    </Grid>
                </Border>

                <!-- Browse grid (Library / Playlist / Favorites / Recently Added) -->
                <ListBox x:Name="LibraryGrid" Grid.Row="0" Margin="12"
                         Visibility="{Binding ShowLibraryBrowser, Converter={StaticResource BoolToVis}}"
                         Style="{StaticResource PlaylistList}"
                         ItemsSource="{Binding MainListView}"
                         SelectedItem="{Binding SelectedItem}"
                         MouseDoubleClick="OnLibraryDoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel IsItemsHost="True" Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="180" Margin="6" Background="{StaticResource PanelLightBrush}"
                                    CornerRadius="8" Padding="0,0,0,8">
                                <StackPanel>
                                    <Border Height="100" Background="#0C000000" CornerRadius="8,8,0,0"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Image Stretch="UniformToFill"
                                                   svc:LazyThumbnail.Item="{Binding}"/>
                                            <TextBlock Text="{Binding DurationLabel}" FontSize="11"
                                                       Foreground="White" Background="#99000000"
                                                       Padding="4,1" Margin="0,0,6,6"
                                                       HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding FileName}" FontSize="12" Margin="8,8,8,2"
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="8,2,0,0">
                                        <TextBlock Text="{Binding DateAdded, StringFormat=dd MMM yyyy}"
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="★" FontSize="11" Margin="6,0,0,0"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush"
                                                        Value="{StaticResource AccentBrush}"/>
                                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- Seek row -->
                <StackPanel Grid.Row="1" Margin="12,0,12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding CurrentTimeText}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" MinWidth="46"/>
                        <Slider Grid.Column="1" x:Name="SeekSlider" Style="{StaticResource MediaSlider}"
                                Maximum="1" SmallChange="0.01" LargeChange="0.05"
                                Value="{Binding Position, Mode=TwoWay}" Margin="8,0"
                                Thumb.DragStarted="OnSeekDragStarted"
                                Thumb.DragCompleted="OnSeekDragCompleted"/>
                        <TextBlock Grid.Column="2" Text="{Binding TotalTimeText}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" MinWidth="46" TextAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- ================= Playlist (kanan) -->
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Tabs + add -->
                    <Grid Margin="8,8,8,4">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="TabPlaylist" Style="{StaticResource NavButton}" GroupName="ptab"
                                         Content="Playlist" IsChecked="True" Margin="0"
                                         Command="{Binding SetTabCommand}" CommandParameter="Playlist"/>
                            <RadioButton Style="{StaticResource NavButton}" GroupName="ptab"
                                         Content="Now Playing" Margin="0"
                                         Command="{Binding SetTabCommand}" CommandParameter="NowPlaying"/>
                        </StackPanel>
                        <Button Style="{StaticResource IconButton}" Content="＋" FontSize="16"
                                HorizontalAlignment="Right" ToolTip="Add video to playlist"
                                Click="OnAddToPlaylistClick"/>
                    </Grid>

                    <!-- Header info -->
                    <TextBlock Grid.Row="1" Text="{Binding PlaylistHeader}" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="16,2,8,6"/>

                    <!-- Items -->
                    <ListBox x:Name="PlaylistList" Grid.Row="2" Style="{StaticResource PlaylistList}"
                             ItemsSource="{Binding RightPanelItems}"
                             SelectedItem="{Binding SelectedItem}"
                             Margin="4,0,4,4"
                             MouseDoubleClick="OnPlaylistDoubleClick"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionMode="Single">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" CornerRadius="6" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="64" Height="36" Background="#0F000000"
                                                CornerRadius="4" ClipToBounds="True">
                                            <Image Stretch="UniformToFill"
                                                   svc:LazyThumbnail.Item="{Binding}"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="10,0,6,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                                            <TextBlock FontSize="11" Margin="0,3,0,0"
                                                       Foreground="{StaticResource TextSecondaryBrush}">
                                                <Run Text="{Binding DurationLabel, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                            <TextBlock Text="{Binding StatusGlyph}" FontSize="11"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"
                                                       Visibility="{Binding ShowStatusGlyph, Converter={StaticResource BoolToVis}}"/>
                                            <Button Style="{StaticResource IconButton}" Content="⋯"
                                                    FontSize="14" Padding="4"
                                                    Click="OnItemMenuClick"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" Background="Transparent" CornerRadius="6"
                                                    Margin="2,1">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background"
                                                            Value="{StaticResource PanelHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background"
                                                            Value="{StaticResource PanelLightBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Play now" Click="OnCtxPlay"/>
                                <MenuItem Header="Remove from playlist" Click="OnCtxRemove"/>
                                <MenuItem Header="Mark as Favorite / Unfavorite" Click="OnCtxFavorite"/>
                                <MenuItem Header="Reveal in Explorer" Click="OnCtxReveal"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>

                    <!-- Bottom of right panel: volume -->
                    <StackPanel Grid.Row="3" Margin="12,4,12,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource IconButton}" Content="🔊" FontSize="12"
                                    Command="{Binding ToggleMuteCommand}"/>
                            <Slider Grid.Column="1" x:Name="VolumeSlider" Style="{StaticResource MediaSlider}"
                                    Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}"
                                    Margin="6,0" ValueChanged="OnVolumeSliderChanged"/>
                            <TextBlock Grid.Column="2" Text="{Binding VolumePercent}" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================================================= ROW 2 : Bottom controls -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Content="⟲" ToolTip="Repeat (off)"
                        IsEnabled="False" Opacity="0.5"/>
                <Button Style="{StaticResource IconButton}" Content="🔀" ToolTip="Shuffle (off)"
                        IsEnabled="False" Opacity="0.5"/>
                <Button Style="{StaticResource IconButton}" Command="{Binding SeekStepCommand}"
                        CommandParameter="-" Content="10s≪" ToolTip="Back (Ctrl+Left)" FontSize="12"/>
                <Button Style="{StaticResource IconButton}" Command="{Binding ToggleMuteCommand}"
                        x:Name="MuteBtn" Content="🔊" ToolTip="Mute / unmute"/>
                <Button Style="{StaticResource PlayCircleButton}" Command="{Binding TogglePlayPauseCommand}"
                        Margin="10,0" Content="{Binding PlayIcon, Mode=OneWay}" FontSize="16"
                        ToolTip="Play / Pause (Space)"/>
                <Button Style="{StaticResource IconButton}" Command="{Binding PlayPreviousCommand}"
                        Content="⏮" ToolTip="Previous"/>
                <Button Style="{StaticResource IconButton}" Command="{Binding PlayNextCommand}"
                        Content="⏭" ToolTip="Next"/>
                <Button Style="{StaticResource IconButton}" Command="{Binding SeekStepCommand}"
                        CommandParameter="+" Content="≫10s" ToolTip="Forward (Ctrl+Right)" FontSize="12"/>
                <Button Style="{StaticResource IconButton}" Content="CC" ToolTip="Subtitles (auto .srt)"
                        IsEnabled="False" Opacity="0.5" FontSize="11"/>
                <Button Style="{StaticResource IconButton}" Command="{Binding ToggleFullscreenCommand}"
                        Content="⛶" ToolTip="Fullscreen (F)"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
